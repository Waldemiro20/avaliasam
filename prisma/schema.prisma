// Schema do AvaliaSAM — Postgres (Supabase).
// Todas as tabelas ficam no schema `public` com RLS habilitado e SEM políticas
// (ver migration), de modo que a API pública do Supabase (anon/authenticated)
// não consegue ler nem escrever. Apenas o servidor, via Prisma, acessa os dados.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "cloudflare"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EVALUATOR
}

model AdminUser {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  sessions     Session[]

  @@map("admin_users")
}

model Event {
  id              String      @id @default(uuid()) @db.Uuid
  name            String
  description     String
  /// Teto de investimento por projeto, em reais (inteiro).
  investmentLimit Int         @map("investment_limit")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  projects        Project[]
  evaluators      Evaluator[]

  @@map("events")
}

model Project {
  id              String   @id @default(uuid()) @db.Uuid
  eventId         String   @map("event_id") @db.Uuid
  name            String
  members         String
  description     String
  prototypeUrl    String?  @map("prototype_url")
  presentationUrl String?  @map("presentation_url")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  votes           Vote[]

  @@index([eventId])
  @@map("projects")
}

model Evaluator {
  id              String    @id @default(uuid()) @db.Uuid
  eventId         String    @map("event_id") @db.Uuid
  name            String
  /// SHA-256 (hex) do token do link. O token em texto puro nunca é armazenado.
  tokenHash       String    @unique @map("token_hash")
  /// Primeiros caracteres do token, apenas para identificação visual no painel.
  tokenPrefix     String    @map("token_prefix")
  /// Token criptografado (AES-256-GCM) para o admin copiar o link novamente.
  /// Nulo para convites criados antes desta coluna existir.
  tokenCiphertext String?   @map("token_ciphertext")
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)
  submittedAt     DateTime? @map("submitted_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  event           Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  votes           Vote[]
  sessions        Session[]

  @@index([eventId])
  @@map("evaluators")
}

model Vote {
  evaluatorId String    @map("evaluator_id") @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  /// Valor investido em reais (inteiro), entre 0 e o teto do evento.
  amount      Int
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  evaluator   Evaluator @relation(fields: [evaluatorId], references: [id], onDelete: Cascade)
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([evaluatorId, projectId])
  @@index([projectId])
  @@map("votes")
}

/// Sessões emitidas (o JWT carrega apenas o id). Revogar = preencher revoked_at.
model Session {
  id          String     @id @default(uuid()) @db.Uuid
  role        Role
  adminId     String?    @map("admin_id") @db.Uuid
  evaluatorId String?    @map("evaluator_id") @db.Uuid
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime?  @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  admin       AdminUser? @relation(fields: [adminId], references: [id], onDelete: Cascade)
  evaluator   Evaluator? @relation(fields: [evaluatorId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([evaluatorId])
  @@map("sessions")
}

/// Contadores de rate limiting por janela fixa (funciona em ambiente serverless).
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime @map("window_start") @db.Timestamptz(3)

  @@map("rate_limits")
}
