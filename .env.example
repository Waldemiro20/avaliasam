# Copie para .env (local) e configure as mesmas variáveis no ambiente de produção.
# NUNCA faça commit do .env com valores reais.

# Supabase → Project Settings → Database → Connection string
# Runtime: pooler em modo transação (porta 6543)
DATABASE_URL="postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations / script de admin: conexão direta ou session pooler (porta 5432)
DIRECT_URL="postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres"

# Segredo do JWT de sessão (mín. 32 caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

